<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= siteTitle %> | <%= pageTitle %>
    </title>
</head>

<body>
    <h2><%= pageTitle %></h2>
    <div>
        <a href="/">Home</a>
        <a href="/logout">Logout</a>
    </div>
    <span class="info-messages">
        <%- include("../partials/errors.ejs") %>
        <%- include("../partials/successes.ejs") %>
    </span>
    <div>
        <form method="POST" action="<%= formActionSubmit %>">
            <label for="title">Title
                <input type="text" id="title" name="title" placeholder="Title"
                    value="<%= typeof locals.oldData !== 'undefined' &&  locals.oldData ? oldData.title : ''  %>">
            </label>
            <label for="messageBody">Message
                <textarea name="messageBody" placeholder="Type message here..."
                    id="messageBody"><%= typeof locals.oldData !== 'undefined' &&  locals.oldData ? oldData.messageBody : ''  %></textarea>
            </label>

            <button><%= action %></button>
        </form>
    </div>

</body>

</html>