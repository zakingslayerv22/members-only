<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body>
    <%- include('../partials/header.ejs') %>
    <p><%= pageTitle %></p>
    <div>
        <% if (typeof locals.currentUser !== 'undefined' &&  !currentUser.is_admin && currentUser.is_club_member) {%>
        <p>Hello <%= currentUser.first_name %>. <a href="/users/join-admins">Join</a> the admins to be able to delete
            user
            messages.</p>
        <% } %>

        <% if (typeof locals.currentUser !== 'undefined' &&  !currentUser.is_club_member) {%>
        <p>Hello <%= currentUser.first_name %>, you can start sending messages. <a href="/users/join-club">Join</a> the
            club to see who sent what.</p>
        <% } %>

        <% if (!currentUser) {%>
        <p>Hello stranger, only club members can send messages and see who sent what. <a href="/users/login">Login</a>
            or <a href="/users/signup">Sign
                Up </a>to continue.</p>
        <% } %>
    </div>
    <div class="messages-container">
        <% if (locals.messagesAndSenderNames.length){ %>
        <% messagesAndSenderNames.forEach((message) => { %>
        <div class="message-card">
            <a href="/messages/<%= message.id %>">
                <p><strong><%= message.msg_title %></strong></p>
                <p><%= message.msg_body %></p>
                <% if (locals.currentUser && currentUser.is_club_member){ %>
                <p><%= message.created_at %></p>
                <p>Sent by: <%= message.first_name %> <%= message.last_name %></p>
                <% } %>
            </a>
            <% if (locals.currentUser && currentUser.is_admin){ %>
            <div class="message-actions">
                <form action="/messages/<%= message.id %>/delete" method="POST">
                    <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this message?');">Delete</button>
                </form>
            </div>
            <% } %>
        </div>
        <% }) %>
        <% } else {%>
        <p>No messages yet. Be the first to <a href="/messages/new" class="btn">send an anonymous message</a></p>
        <% } %>
    </div>

    </div>
    <%- include('../partials/footer.ejs') %>
</body>

</html>