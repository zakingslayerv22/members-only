<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= siteTitle %> | <%= pageTitle %>
    </title>
</head>

<body>

    <h2><%= siteTitle %></h2>
    <p><%= typeof locals.currentUser !== 'undefined' &&  currentUser ? `Welcome ${currentUser.first_name}` : "Hello Guest" %>
    </p>
    <span class="info-messages">
        <%- include("../partials/errors.ejs") %>
        <%- include("../partials/successes.ejs") %>
    </span>
    <div>
        <% if (typeof locals.currentUser !== 'undefined' &&  currentUser){ %>
        <a href="/messages/new" class="btn">Send New Message</a>
        <a href="/users/logout" class="btn">Logout</a>
        <% } else {%>
        <a href="/users/signup" class="btn">Sign Up</a>
        <a href="/users/login" class="btn">Login</a>
        <% } %>

        <div class="messages-container">
            <% if (locals.messagesAndSenderNames.length){ %>
            <% messagesAndSenderNames.forEach((message) => { %>
            <div class="message-card">
                <a href="/messages/<%= message.id %>">
                    <p><strong><%= message.msg_title %></strong></p>
                    <p><%= message.msg_body %></p>
                    <% if (locals.currentUser && currentUser.is_club_member){ %>
                    <p><%= message.created_at %></p>
                    <p>Sent by: <%= message.first_name %> <%= message.last_name %></p>
                    <% } %>
                </a>
            </div>
            <% }) %>
            <% } else {%>
            <p>No messages yet. Be the first to <a href="/messages/new" class="btn">send an anonymous message</a></p>
            <% } %>
        </div>

    </div>

</body>

</html>