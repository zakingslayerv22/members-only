<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body>
    <div class="content-layout">
        <%- include('../partials/header.ejs') %>
        <main class="main-content">
            <p class="page-title"><%= pageTitle %></p>
            <div class="page-info">
                <% if (typeof locals.currentUser !== 'undefined' && currentUser.is_admin) {%>
                <p>Hello <%= currentUser.first_name %>, help keep the message board tidy!</p>
                <% } %>

                <% if (typeof locals.currentUser !== 'undefined' &&  !currentUser.is_admin && currentUser.is_club_member) {%>
                <p>Hello <%= currentUser.first_name %>. <a href="/users/join-admins">Join</a> the admins to be able to
                    delete
                    user
                    messages.</p>
                <% } %>

                <% if (typeof locals.currentUser !== 'undefined' &&  !currentUser.is_club_member) {%>
                <p>Hello <%= currentUser.first_name %>, start sending messages. <a href="/users/join-club">Join</a>
                    the
                    club to see who sent what.</p>
                <% } %>

                <% if (!currentUser) {%>
                <p>Hello stranger, only club members can send messages and see who sent what. <a
                        href="/users/login">Login</a>
                    or <a href="/users/signup">Sign up</a> to continue.</p>
                <% } %>
            </div>
            <div class="messages-container">
                <% if (locals.messagesAndSenderNames.length){ %>
                <% messagesAndSenderNames.forEach((message) => { %>
                <div class="message-card">

                    <% if (locals.currentUser && currentUser.is_club_member){ %>

                    <p class="created-at">
                        <time datetime="<%= new Date(message.created_at).toISOString() %>"
                            title="<%= message.created_at %>">
                            <%= new Date(message.created_at).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short'
    }) %>
                        </time>
                    </p>
                    <% } %>

                    <div class="message-title-and-body">
                        <p><strong><%= message.msg_title %></strong></p>
                        <p><%= message.msg_body %></p>
                    </div>

                    <div class="sender-and-message-action">
                        <% if (locals.currentUser && currentUser.is_club_member){ %>

                        <p class="sender">@ <%= message.first_name %>
                            <%= message.last_name %></p>
                        <% } %>

                        <% if (locals.currentUser && currentUser.is_admin){ %>
                        <div class="message-actions">
                            <form action="/messages/<%= message.id %>/delete" method="POST">
                                <button type="submit" class="button-delete"
                                    onclick="return confirm('Are you sure you want to delete this message?');">Delete</button>
                            </form>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
                <% } else {%>
                <p class="no-messages-yet-info">No messages yet. Be the first to <a href="/messages/new"
                        class="btn">send a message.</a>
                </p>
                <% } %>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </div>
</body>

</html>