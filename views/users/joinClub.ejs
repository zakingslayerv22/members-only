<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= siteTitle %> | <%= pageTitle %>
    </title>
</head>

<body>
    <h2><%= pageTitle %></h2>
    <div>
        <a href="/" class="btn">Home</a>
        <a href="/messages/new" class="btn">Send New Message</a>
        <a href="/users/logout" class="btn">Logout</a>
    </div>
    <span class="info-messages">
        <%- include("../partials/alerts.ejs") %>
    </span>
    <div>
        <form method="POST" action="<%= formActionSubmit %>">
            <label for="answer">What is one selfless quality you possess?
                <input type="text" id="answer" name="answer" placeholder="altruism"
                    value="<%= typeof previousAnswer !== 'undefined' && previousAnswer ? previousAnswer : ''  %>"
                    required>
            </label>

            <button><%= action %></button>
        </form>
    </div>

</body>

</html>