<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body>
    <div class="content-layout">
        <%- include('../partials/header.ejs') %>
        <main class="main-content">
            <%- include('../partials/pageTitle.ejs') %>
            <p class="page-info">Answer the question to join the club.</p>
            <div class="form-container">
                <form method="POST" action="<%= formActionSubmit %>">
                    <label for="answer">What is one selfless quality you possess?
                        <input type="text" id="answer" name="answer" placeholder="altruism"
                            value="<%= typeof previousAnswer !== 'undefined' && previousAnswer ? previousAnswer : ''  %>"
                            required>
                    </label>

                    <button class="button-submit"><%= action %></button>
                </form>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </div>
</body>

</html>