<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body>
    <div class="content-layout">
        <%- include('../partials/header.ejs') %>
        <main class="main-content">
            <%- include('../partials/pageTitle.ejs') %>
            <p class="page-info">Login to continue sending messages.</p>
            <div class="form-container">
                <form method="POST" action="<%= formActionSubmit %>">
                    <label for="email">Email
                        <input type="text" id="email" name="email" placeholder="Email Address"
                            value="<%= typeof user !== 'undefined' && user ? user.email : ''  %>" required>
                    </label>

                    <label for="password">Password
                        <input type="password" id="password" name="password" placeholder="Password" required>
                    </label>

                    <button class="button-submit"><%= action %></button>
                </form>
                <span>Don't have an account yet? <a href="/users/signup">Sign Up</a>.</span>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </div>
</body>

</html>